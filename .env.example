# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

# --- Database ---
# Matches the credentials we'll set in docker-compose.yml
DATABASE_URL=postgresql://churn_user:churn_pass@localhost:5432/churn_db

# --- LLM Provider ---
# Which backend the RAG layer calls: "groq" (free) or "anthropic" (paid, optional)
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional - only needed if you switch LLM_PROVIDER to anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
